<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 같은 WiFi의 PC 서버(HTTP)에 연결해야 하므로 cleartext 허용 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
